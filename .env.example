# Copy this to .env and fill in real values.
# Real network calls need at least one of GROQ_API_KEY / GEMINI_API_KEY.
GROQ_API_KEY=
GEMINI_API_KEY=

# Set to 1 to run entirely offline with canned responses (no network calls).
# This is the fallback for bad wifi or a rate limit during the demo.
MOCK_LLM=0

# Frontend flag — voice is off by default.
VITE_ENABLE_VOICE=false
