# Copy to .env (in this frontend/ directory, not the repo root -- Vite
# only reads env files from its own project root). Only VITE_-prefixed
# vars are exposed to client code; see App.jsx.
#
# Leave blank for local dev -- App.jsx falls back to http://localhost:8000.
# On Render, this is set directly as a service env var (see render.yaml),
# which Vite picks up at build time without needing this file at all.
VITE_API_BASE=
